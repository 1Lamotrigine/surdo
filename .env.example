SECRET_KEY=change-me-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost

# --- Продакшен (G4) ---------------------------------------------------------
# На сервере: DEBUG=False, реальный домен и HTTPS (см. docs/DEPLOY.md).
# SITE_ADDRESS — домен для Caddy: он сам получит TLS-сертификат Let's Encrypt
# и сделает редирект HTTP→HTTPS. Локально оставьте пустым (Caddy откроет :80).
#   SITE_ADDRESS=lecture.example.org
#   ACME_EMAIL=admin@example.org
#   DEBUG=False
#   ALLOWED_HOSTS=lecture.example.org
#   CSRF_TRUSTED_ORIGINS=https://lecture.example.org
SITE_ADDRESS=
ACME_EMAIL=
# Безопасные куки и HSTS включаются вместе с DEBUG=False. Можно выключить,
# если HTTPS завершает прокси университета и редирект не нужен.
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SECURE_HSTS_SECONDS=31536000

# Пароль PostgreSQL; продублирован в DATABASE_URL (значение должно совпадать).
DB_PASSWORD=change-me
DATABASE_URL=postgres://app:change-me@db:5432/app
REDIS_URL=redis://redis:6379/0

# ИИ-модули (понадобятся на этапах F).
# Пустые LLM_MODEL/LLM_API_KEY включают упрощённый режим без обращения к сети.
# LLM_PROVIDER=openai — OpenAI-compatible API, ollama — локальная Ollama.
# LLM_API_URL можно указать для прокси или своего endpoint.
LLM_PROVIDER=openai
LLM_MODEL=
LLM_API_KEY=
LLM_API_URL=
LLM_TIMEOUT=8
# Предел ожидания сжатия фразы при отставании аватара (FR-16).
COMPRESS_TIMEOUT=4
# Модель faster-whisper: имя (tiny/base/small/medium/large-v3) или путь.
# Устройство: cpu, cuda или auto. На CPU используется int8, на CUDA — float16.
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
# Таймаут распознавания одной фразы, секунды (ТЗ 5.7).
ASR_TIMEOUT=20
ASR_MAX_CONCURRENCY=2
ROOM_QUEUE_MAX=5

MEDIA_ROOT=/app/media
RETENTION_DAYS=90

# VRM-модель аватара (C1): URL файла .vrm. Пусто — тестовая страница /avatar/
# откроется без модели (сцена, камера и свет уже работают).
AVATAR_MODEL_URL=

# Модель MediaPipe Holistic для инструмента записи (D1). Официальная модель
# Google скачивается браузером один раз; для офлайна укажите свой URL .task.
MEDIAPIPE_HOLISTIC_MODEL_URL=https://storage.googleapis.com/mediapipe-models/holistic_landmarker/holistic_landmarker/float16/1/holistic_landmarker.task

# Vite: False — отдавать собранные файлы из static/dist (как в образе),
# True — брать модули с dev-сервера Vite (npm run dev) с HMR.
DJANGO_VITE_DEV_MODE=False
DJANGO_VITE_DEV_SERVER_HOST=localhost
DJANGO_VITE_DEV_SERVER_PORT=5173

# Начальный администратор для `make seed-admin`.
# Пароль должен проходить валидаторы Django (длина, не общий, не числовой).
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Администратор

# Ограничение перебора ID комнаты студентом: попыток за окно (секунд) на IP.
JOIN_RATE_LIMIT_ATTEMPTS=10
JOIN_RATE_LIMIT_WINDOW=60

# Ограничение чата: сообщений за окно (секунд) на участника.
CHAT_RATE_LIMIT_MESSAGES=5
CHAT_RATE_LIMIT_WINDOW=5

# Heartbeat WebSocket: интервал ping клиента и таймаут без ping (секунды).
ROOM_PING_INTERVAL=20
ROOM_PING_TIMEOUT=60

# Загрузка клипа жеста (формат — docs/spec/clip-format.md).
CLIP_VERSION=1
CLIP_MAX_SIZE_BYTES=2097152
CLIP_MAX_FRAMES=300
CLIP_DEFAULT_FPS=30
