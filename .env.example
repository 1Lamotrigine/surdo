SECRET_KEY=change-me-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost

# Пароль PostgreSQL; продублирован в DATABASE_URL (значение должно совпадать).
DB_PASSWORD=change-me
DATABASE_URL=postgres://app:change-me@db:5432/app
REDIS_URL=redis://redis:6379/0

# ИИ-модули (понадобятся на этапах F).
LLM_PROVIDER=openai
LLM_MODEL=
LLM_API_KEY=
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
ASR_MAX_CONCURRENCY=2
ROOM_QUEUE_MAX=5

MEDIA_ROOT=/app/media
RETENTION_DAYS=90

# Vite: False — отдавать собранные файлы из static/dist (как в образе),
# True — брать модули с dev-сервера Vite (npm run dev) с HMR.
DJANGO_VITE_DEV_MODE=False
DJANGO_VITE_DEV_SERVER_HOST=localhost
DJANGO_VITE_DEV_SERVER_PORT=5173

# Начальный администратор для `make seed-admin`.
# Пароль должен проходить валидаторы Django (длина, не общий, не числовой).
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Администратор

# Ограничение перебора ID комнаты студентом: попыток за окно (секунд) на IP.
JOIN_RATE_LIMIT_ATTEMPTS=10
JOIN_RATE_LIMIT_WINDOW=60

# Ограничение чата: сообщений за окно (секунд) на участника.
CHAT_RATE_LIMIT_MESSAGES=5
CHAT_RATE_LIMIT_WINDOW=5

# Heartbeat WebSocket: интервал ping клиента и таймаут без ping (секунды).
ROOM_PING_INTERVAL=20
ROOM_PING_TIMEOUT=60
